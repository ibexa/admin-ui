includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/ibexa/phpstan/extension.neon

parameters:
    level: 8
    paths:
        - src
        - tests

    # Its own separate composer project (own vendor/autoload.php, own
    # dependencies) — unresolvable from this root autoloader by design.
    excludePaths:
        - tests/playwright-tests-php/*

    ignoreErrors:
        -
            message: "#^Cannot call method (log|debug|info|notice|warning|error|critical|alert|emergency)\\(\\) on Psr\\\\Log\\\\LoggerInterface\\|null\\.$#"
