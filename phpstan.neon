includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/ibexa/phpstan/extension.neon

parameters:
    level: 8
    paths:
        - src
        - tests

    # ibexa/cohesivo-playwright (IbexaPlaywrightTestCase etc.) is only added
    # as a dependency of the assembled project these tests actually run
    # against (gh-workflows' CI step), never of this repo's own standalone
    # composer install — unresolvable from this root autoloader by design.
    excludePaths:
        - tests/playwright-tests-php/*

    ignoreErrors:
        -
            message: "#^Cannot call method (log|debug|info|notice|warning|error|critical|alert|emergency)\\(\\) on Psr\\\\Log\\\\LoggerInterface\\|null\\.$#"
