{
    "name": "admin-ui",
    "repository": "git@github.com:ibexa/admin-ui.git",
    "private": true,
    "prettier": "@ibexa/eslint-config/prettier",
    "dependencies": {},
    "devDependencies": {
        "@ibexa/eslint-config": "https://github.com/ibexa/eslint-config-ibexa.git#~v2.0.0",
        "@ibexa/ts-config": "https://github.com/ibexa/ts-config-ibexa#~v2.0.0",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@typescript-eslint/typescript-estree": "^8.62.1"
    },
    "scripts": {
        "test": "yarn prettier-test && yarn ts-test && yarn eslint-test",
        "fix": "yarn prettier-test --write && yarn ts-test && yarn eslint-test --fix",
        "ts-test": "tsc --noEmit",
        "eslint-test": "eslint .",
        "prettier-test": "yarn prettier \"./src/bundle/**/*.{js,ts,tsx,scss}\" --check",
        "postinstall": "yarn ibexa-generate-tsconfig"
    }
}
