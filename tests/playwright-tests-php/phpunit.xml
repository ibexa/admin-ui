<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="bootstrap.php"
         colors="true">
    <php>
        <!-- HostOnlyKernel (real-HTTP architecture spike): isolates the host-side
             test kernel's cache/log dirs from the containerized app's — see its
             own docblock in ibexa/cohesivo-playwright for why. -->
        <env name="KERNEL_CLASS" value="Ibexa\CohesivoPlaywright\Fixture\HostOnlyKernel"/>
    </php>
    <testsuites>
        <testsuite name="admin-ui-playwright-php">
            <directory>Tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
