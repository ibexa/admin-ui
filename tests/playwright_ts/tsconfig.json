{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@ibexa/cohesivo-playwright": ["node_modules/@ibexa/cohesivo-playwright/src"],
      "@ibexa/cohesivo-playwright/*": ["node_modules/@ibexa/cohesivo-playwright/src/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
