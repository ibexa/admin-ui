{% block mail_row %}
    {% set base_style = '
        padding: 0 40px 20px 40px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 14px;
        line-height: 21px;
        color: #0e1216;' %}

    <tr>
        <td style="{{ base_style ~ style|default('') }}" class="ibexa-email-content">
            {{ content|raw }}
        </td>
    </tr>
{% endblock mail_row %}
