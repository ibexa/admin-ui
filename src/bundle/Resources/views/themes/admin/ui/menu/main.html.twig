{% extends '@ibexadesign/ui/menu/main_base.html.twig' %}

{% block root %}
    {% set extra_class = 'ibexa-main-menu__navbar--collapsed' %}
    {% set current_item = item %}
    {% set top_level_items = current_item.children|filter(item => item.extras.bottom_item is not defined or not item.extras.bottom_item) %}
    {% set bottom_level_items = current_item.children|filter(item => item.extras.bottom_item is defined and item.extras.bottom_item) %}

    <div class="ibexa-main-menu__navbar ibexa-main-menu__navbar--first-level {{ extra_class }}">
        <div class="ibexa-main-menu__toggler-container ibexa-main-menu__toggler-container--first-level">
            <twig:ibexa:button
                type="tertiary-alt"
                size="small"
                htmlType="button"
                class="ibexa-main-menu__toggler ibexa-main-menu__expand-toggler ibexa-main-menu__expand-toggler--collapsed ibexa-btn ibexa-btn--small"
                icon="arrow-collapse-left"
                data-tooltip-extra-class="ibexa-tooltip--navigation"
                data-delay-show="0"
                data-expand-label="{{ 'main_menu.action.expand'|trans({}, 'ibexa_menu')|desc('Expand') }}"
                data-collapse-label="{{ 'main_menu.action.collapse'|trans({}, 'ibexa_menu')|desc('Collapse') }}"
                aria-expanded="false"
                aria-label="{{ 'main_menu.action.expand'|trans({}, 'ibexa_menu')|desc('Expand') }}"
                title="{{ 'main_menu.action.expand'|trans({}, 'ibexa_menu')|desc('Expand') }}"
            >
                {{ 'main_menu.action.collapse'|trans({}, 'ibexa_menu')|desc('Collapse') }}
            </twig:ibexa:button>
        </div>
        <div class="ibexa-main-menu__primary-section">
            <ul class="ibexa-main-menu__items-list nav">
                {% for item in top_level_items %}
                    {% if item.children|length > 0 or (item.uri is not empty and (not matcher.isCurrent(item) or options.currentAsLink)) %}
                        {{ block('item') }}
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
        {% if bottom_level_items|length %}
            <div class="ibexa-main-menu__secondary-section">
                <ul class="ibexa-main-menu__items-list nav">
                    {% for item in bottom_level_items %}
                        {% if item.children|length > 0 or (item.uri is not empty and (not matcher.isCurrent(item) or options.currentAsLink)) %}
                            {{ block('item') }}
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block linkElement %}
    {% set classes = [
        'ibexa-main-menu__item-action',
        (matcher.isCurrent(item) ? options.currentClass|trim ~ ' ibexa-main-menu__item-action--selected'),
        (item.linkAttributes.class is defined ? item.linkAttributes.class|trim)
    ] %}
    {% set icon_path = null %}

    {% if item.extras.icon_path|default %}
        {% set icon_path = item.extras.icon_path %}
    {% elseif item.extras.icon is defined and item.extras.icon is not empty %}
        {% set icon_path = ibexa_icon_path(item.extras.icon) %}
    {% endif %}

    <twig:ibexa:link
        href="{{ item.uri }}"
        variant="button"
        type="tertiary-alt"
        size="medium"
        class="{{ classes|join(' ') }}"
        aria-controls="{{ item.name }}"
        iconPath="{{ icon_path }}"
    >
        {{ include('@ibexadesign/ui/menu/main_item_label.html.twig', {
            item: item,
        }) }}
    </twig:ibexa:link>
{% endblock %}

{% block spanElement %}
    {% import 'knp_menu.html.twig' as knp_menu %}

    {% set action_classes = [
        'ibexa-main-menu__item-action',
        (matcher.isAncestor(item, options.matchingDepth) ? options.currentClass|trim ~ ' ibexa-main-menu__item-action--selected'),
        (item.linkAttributes.class is defined ? item.linkAttributes.class|trim)
    ] %}
    {% set icon_path = null %}

    {% if item.extras.icon_path|default %}
        {% set icon_path = item.extras.icon_path %}
    {% elseif item.extras.icon is defined and item.extras.icon is not empty %}
        {% set icon_path = ibexa_icon_path(item.extras.icon) %}
    {% endif %}

    {% if item.hasChildren %}
        {% set is_selected = matcher.isAncestor(item, options.matchingDepth) %}
        {% set popup_id = '%s-popup'|format(item.name) %}
        {% set popup_trigger_classes = (action_classes|merge(['ibexa-main-menu__item-action--popup-trigger']))|join(' ') %}
        {% set accordion_trigger_classes = (action_classes|merge(['ibexa-main-menu__item-action--accordion-trigger']))|join(' ') %}
        <twig:ibexa:button
            type="tertiary-alt"
            size="medium"
            htmlType="button"
            class="{{ popup_trigger_classes }}"
            data-popup-target-selector="#{{ popup_id }}"
            iconPath="{{ icon_path }}"
        >
            {{ include('@ibexadesign/ui/menu/main_item_label.html.twig', {
                item: item,
            }) }}
        </twig:ibexa:button>

        <ul id="{{ popup_id }}" class="ibexa-popup-menu ibexa-popup-menu--navigation ibexa-popup-menu--hidden ibexa-main-menu-popup">
            {% for item in item.children %}
                {% set renderItemAsGroup = item.children|length > 0 %}
                {{ block('popupItem') }}
            {% endfor %}
        </ul>

        <twig:ibexa:accordion
            class="ibexa-main-menu__accordion"
            :initiallyExpanded="is_selected"
            expanderType="chevron"
            :expanderHasLabel="false"
        >
            <twig:block name="header">
                <twig:ibexa:button
                    type="tertiary-alt"
                    size="medium"
                    htmlType="button"
                    class="{{ accordion_trigger_classes }}"
                    data-item-name="{{ item.name }}"
                    iconPath="{{ icon_path }}"
                >
                    {{ include('@ibexadesign/ui/menu/main_item_label.html.twig', {
                        item: item,
                    }) }}
                </twig:ibexa:button>
            </twig:block>

            <twig:block name="content">
                {{ include('@ibexadesign/ui/menu/main_2nd_level_subtree.html.twig', {
                    items: item.children,
                    matcher: matcher,
                    options: options,
                }) }}
            </twig:block>
        </twig:ibexa:accordion>
    {% else %}
        <twig:ibexa:link
            href="{{ item.uri is not empty ? item.uri : '#' ~ item.name }}"
            variant="button"
            type="tertiary-alt"
            size="medium"
            class="{{ action_classes|join(' ') }}"
            iconPath="{{ icon_path }}"
        >
            {{ include('@ibexadesign/ui/menu/main_item_label.html.twig', {
                item: item,
            }) }}
        </twig:ibexa:link>
    {% endif %}
{% endblock %}

{% block popupLinkElement %}
    {% set classes = [
        'ibexa-popup-menu__item-content',
        (matcher.isCurrent(item) ? 'ibexa-popup-menu__item-content--current'),
    ] %}

    <a href="{{ item.uri }}" class="{{ classes|join(' ') }}">
        {{ include('@ibexadesign/ui/menu/main_item_label.html.twig', {
            item: item,
        }) }}
    </a>
{% endblock %}

{% block popupSpanElement %}
    <div class="ibexa-popup-menu__item-content ibexa-main-menu-popup__group-name">
        {{ include('@ibexadesign/ui/menu/main_item_label.html.twig', {
            item: item,
            text_column_class: 'ibexa-main-menu__item-text-column--group',
        }) }}
    </div>
{% endblock %}

{% block label %}
    {% set icon_path = null %}
    {% set icon_class = icon_class|default('ibexa-main-menu__item-icon ibexa-icon ') ~ item.extras.icon_size|default('ibexa-icon--medium ') ~ item.extras.icon_class|default('')|trim %}

    {% if item.extras.icon_path|default %}
        {% set icon_path = item.extras.icon_path %}
    {% elseif item.extras.icon is defined and item.extras.icon is not empty %}
        {% set icon_path = ibexa_icon_path(item.extras.icon) %}
    {% endif %}

    {% if icon_path is not empty %}
        <div class="ibexa-main-menu__item-icon-column">
            <svg class="{{ icon_class }}">
                <use xlink:href="{{ icon_path }}"></use>
            </svg>
        </div>
    {% endif %}

    <div class="ibexa-main-menu__item-text-column">{{ parent() }}</div>
{% endblock %}
