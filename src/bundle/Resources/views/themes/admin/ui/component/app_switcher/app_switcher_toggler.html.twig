{% trans_default_domain 'ibexa_menu' %}

{% set toggler_label = 'app_switcher.toggler.label'|trans|desc('Open app switcher') %}

<twig:ibexa:button
    type="tertiary-alt"
    size="medium"
    htmlType="button"
    class="ibexa-app-switcher-toggler"
    icon_url="{{ asset('bundles/ibexaadminui/img/icons/app-switcher.svg') ~ '#app-switcher' }}"
    aria-controls="ibexa-app-switcher-panel"
    aria-expanded="false"
    aria-label="{{ toggler_label }}"
    title="{{ toggler_label }}"
/>
