{#
    TODO: Remove this compatibility wrapper once every `include`/`embed` call site renders <twig:ibexa:alert> directly.
    Legacy params `size`, `show_subtitle_below` and `attr` are ignored, and the `title` block is gone (title is a prop).
#}
{% set alert_variant = is_toast|default(false) ? 'toast' : 'local' %}
{% set alert_classes = html_classes({ 'ibexa-alert-adapter': not is_toast|default(false) }, class|default('')) %}
{% set alert_description %}
    {%- block content -%}
        {%- block subtitle -%}
            {%- if subtitle is defined -%}
                {{- subtitle -}}
            {%- endif -%}
        {%- endblock -%}
        {%- block extra_content_wrapper -%}
            {%- block extra_content -%}
                {%- if extra_content is defined -%}
                    {{- extra_content|raw -}}
                {%- endif -%}
            {%- endblock -%}
        {%- endblock -%}
    {%- endblock -%}
{% endset %}
{% set alert_actions %}
    {%- block actions_wrapper -%}
        {%- block actions -%}{%- endblock -%}
    {%- endblock -%}
{% endset %}

<twig:ibexa:alert
    type="{{ type }}"
    variant="{{ alert_variant }}"
    :title="title|default('')"
    iconPath="{{ icon_path|default('') }}"
    :isDismissible="show_close_btn|default(false)"
    class="{{ alert_classes }}"
>
    <twig:block name="content">{{ alert_description }}</twig:block>
    <twig:block name="actions">{{ alert_actions }}</twig:block>
</twig:ibexa:alert>
