{#
    Toast template rendered once per notification type into the `data-template-<type>` attributes of
    `.ibexa-notifications-container`; `message` and `icon_path` are `{{ … }}` placeholders that
    admin.notifications.js replaces at runtime. `data-ids-custom-init` keeps the global DS init away —
    the notifications script initialises the Alert behaviour itself for every appended toast.
#}
<twig:ibexa:alert
    type="{{ type }}"
    variant="toast"
    title="{{ message }}"
    iconPath="{{ icon_path }}"
    :isDismissible="true"
    data-ids-custom-init="true"
/>
