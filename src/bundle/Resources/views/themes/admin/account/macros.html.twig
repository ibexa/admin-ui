{% macro error_row(message, error_type = null, is_hidden = false) %}
    <em
        class="ibexa-form-error__row"
        {%- if error_type is not null %} data-error-type="{{ error_type }}"{% endif %}
        {%- if is_hidden %} hidden{% endif -%}
    >
        <svg class="ibexa-icon ibexa-icon--small ibexa-form-error__icon">
            <use xlink:href="{{ ibexa_icon_path('notice') }}"></use>
        </svg>
        {{ message }}
    </em>
{% endmacro %}

{% macro field_errors(errors) %}
    <div class="ibexa-form-error">
        {% for error in errors %}
            {{ _self.error_row(error.message) }}
        {% endfor %}
    </div>
{% endmacro %}
