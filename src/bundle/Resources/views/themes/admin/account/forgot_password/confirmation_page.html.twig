{% extends '@ibexadesign/account/base.html.twig' %}

{%- block content -%}
    <div class="ibexa-login__actions-headline">{{ 'authentication.forgot_password'|trans|desc('Forgot password') }}</div>
    {% include '@ibexadesign/ui/component/alert/alert.html.twig' with {
        type: 'success',
        title: 'ibexa.forgot_user_password.success.alert'|trans|desc('We’ve sent to your email account a link to reset your password.'),
        class: 'mt-4',
    } only %}
    <p class="ibexa-login__actions-subheadline">
        {{ 'ibexa.forgot_user_password.success'|trans|raw
        |desc('<p>If you don’t receive the email, double-check your email address and spam folder.</p>') }}
    </p>
    <div class="ibexa-login__actions">
        <twig:ibexa:link
            href="{{ path('login') }}"
            variant="button"
            type="primary"
            class="ibexa-login__btn"
        >
            {{ 'authentication.reset_your_password.back_to_sign_in'|trans|desc('Back to sign in page') }}
        </twig:ibexa:link>
    </div>
{%- endblock content -%}
