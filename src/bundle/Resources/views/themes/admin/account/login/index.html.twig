{% extends '@ibexadesign/account/base.html.twig' %}
{# TODO: waiting for implementation #}
{% set is_sso = false %}

{%- block content -%}
    {# TODO: change to <twig:ibexa:label when ready #}
    <div class="ibexa-login__actions-headline">{{ 'base.sign_in'|trans|desc('Sign in to Cohesivo') }}</div>

    {% block login_form %}
        {{ ibexa_twig_component_group('admin-ui-login-form-before') }}

        <form
            action="{{ path( 'login_check' ) }}"
            method="post"
            role="form"
            novalidate
            data-account-validate
        >
            <fieldset>
                {% block login_form_errors %}
                    {% if error %}
                        <div class="ibexa-login__errors-container">
                            {% include '@ibexadesign/ui/component/alert/alert.html.twig' with {
                                type: 'error',
                                title: error.message|trans,
                            } only %}
                        </div>
                    {% endif %}
                {% endblock %}

                {% block login_form_fields %}
                    {% from '@ibexadesign/account/macros.html.twig' import error_row %}

                    <div class="form-group{% if error %} has-error{% endif %}">
                        <div class="ibexa-login__input-label-wrapper">
                            <twig:ibexa:label for="username">{{ 'authentication.login'|trans|desc('Login') }}</twig:ibexa:label>
                        </div>
                        {%- include '@ibexadesign/ui/component/input_text_ds.html.twig' with {
                            type: 'text',
                            input_attr: {
                                id: 'username',
                                class: 'ibexa-login__input ibexa-login__input--name',
                                name: '_username',
                                value: last_username,
                                required: true,
                                autofocus: true,
                                autocomplete: 'on',
                                tabindex: '1',
                                placeholder: ' '
                            }
                        } only -%}
                        <div class="ibexa-form-error">
                            {{ error_row(
                                'error.required.field'|trans({ '%fieldName%': 'authentication.login'|trans|desc('Login') }, 'forms')|desc('%fieldName% cannot be empty.'),
                                'empty',
                                true
                            ) }}
                        </div>
                    </div>
                    <div class="form-group{% if error %} has-error{% endif %} position-relative">
                        <div class="ibexa-login__input-label-wrapper">
                            <twig:ibexa:label for="password">{{ 'authentication.password'|trans|desc('Password') }}</twig:ibexa:label>
                        </div>
                        {%- include '@ibexadesign/ui/component/input_text_ds.html.twig' with {
                            type: 'password',
                            input_attr: {
                                id: 'password',
                                class: 'ibexa-login__input ibexa-login__input--password',
                                name: '_password',
                                required: true,
                                tabindex: '2',
                                placeholder: ' '
                            }
                        } only -%}
                        <div class="ibexa-form-error">
                            {{ error_row(
                                'error.required.field'|trans({ '%fieldName%': 'authentication.password'|trans|desc('Password') }, 'forms')|desc('%fieldName% cannot be empty.'),
                                'empty',
                                true
                            ) }}
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token("authenticate") }}" />
                {% endblock %}

                {% block login_form_buttons %}
                    <div class="ibexa-login__link-wrapper">
                        <a href="{{ path('ibexa.user.forgot_password') }}" tabindex="4">{{ 'authentication.forgot_your_password'|trans|desc('Forgot your password?') }}</a>
                    </div>
                    <twig:ibexa:button
                        type="primary"
                        htmlType="submit"
                        class="ibexa-login__btn ibexa-login__btn--sign-in"
                        tabindex="3"
                    >
                        {{ 'authentication.sign_in'|trans|desc('Sign in') }}
                    </twig:ibexa:button>
                    {% if is_sso %}
                        <div class="ibexa-login__or-divider">
                            <span>{{ 'authentication.login_or'|trans|desc('or') }}</span>
                        </div>
                        <twig:ibexa:button
                            type="secondary"
                            htmlType="submit"
                            class="ibexa-login__btn"
                            tabindex="3"
                        >
                            {{ 'authentication.sso'|trans|desc('Sign in with SSO') }}
                        </twig:ibexa:button>
                    {% endif %}
                {% endblock %}
            </fieldset>
        </form>

        {{ ibexa_twig_component_group('admin-ui-login-form-after') }}
    {% endblock %}

    {{ encore_entry_script_tags('ibexa-admin-ui-login-js', null, 'ibexa') }}
{%- endblock content -%}
