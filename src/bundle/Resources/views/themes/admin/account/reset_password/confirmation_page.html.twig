{% extends '@ibexadesign/account/base.html.twig' %}

{%- block content -%}
    <h1 class="ibexa-login__actions-headline">{{ 'ezplatform.reset_user_password.change_password'|trans|desc('Set new password') }}</h1>
    <twig:ibexa:alert
        type="success"
        variant="local"
        class="ibexa-login__reset-password-alert"
    >
        {{ 'ezplatform.reset_user_password.success'|trans({ '%login%': path('login') }, 'messages')
            |desc('Your password has been changed. You can <a class="ibexa-login__reset-password-alert-link" href="%login%">log in</a> to Cohesivo.')|raw }}
    </twig:ibexa:alert>
    <div class="ibexa-login__actions">
        <twig:ibexa:link
            href="{{ path('login') }}"
            variant="button"
            type="primary"
            class="ibexa-login__btn"
        >
            {{ 'authentication.reset_your_password.back_to_sign_in'|trans|desc('Back to sign in page') }}
        </twig:ibexa:link>
    </div>
{%- endblock content -%}
