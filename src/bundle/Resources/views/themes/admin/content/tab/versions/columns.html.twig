{% trans_default_domain 'ibexa_locationview' %}

{# Header/cell blocks for the core versions-table columns, rendered by VersionsTableSubscriber
   through the ibexa.Table component. Header blocks return the label markup, cell blocks the
   <td> content; th/td wrappers and their modifier classes come from Column options. #}

{% block checkbox_header %}
    <div class="ibexa-table__header-cell-checkbox-wrapper">
        <label for="ibexa-versions-table-select-all-{{ variant }}" class="visually-hidden">
            {{ 'tab.versions.table.select_all'|trans|desc('Select all versions') }}
        </label>
        <input
            id="ibexa-versions-table-select-all-{{ variant }}"
            class="ibexa-input ibexa-input--checkbox ibexa-table__header-cell-checkbox"
            type="checkbox"
        >
    </div>
{% endblock %}

{% block checkbox_cell %}
    {{ form_widget(form.versions[version.versionNo], {'attr': {'disabled': not version.canDelete}}) }}
{% endblock %}

{% block version_header %}{{ 'tab.versions.table.version'|trans()|desc('Version') }}{% endblock %}

{% block version_cell %}{{ version.versionNo }}{% endblock %}

{% block modified_language_header %}{{ 'tab.versions.table.modified_language'|trans()|desc('Modified language') }}{% endblock %}

{% block modified_language_cell %}{{ ibexa_admin_ui_config.languages.mappings[version.initialLanguageCode].name }}{% endblock %}

{% block contributor_header %}{{ 'tab.versions.table.contributor'|trans()|desc('Contributor') }}{% endblock %}

{% block contributor_cell %}
    {% if version.author is not empty %}
        {% include '@ibexadesign/ui/component/user/user.html.twig' with { user: version.author } only %}
    {% else %}
        {{ 'tab.versions.table.author.not_found'|trans|desc('Can\'t fetch contributor') }}
    {% endif %}
{% endblock %}

{% block created_header %}{{ 'tab.versions.table.created'|trans()|desc('Created') }}{% endblock %}

{% block created_cell %}{{ version.creationDate|ibexa_full_datetime }}{% endblock %}

{% block last_saved_header %}{{ 'tab.versions.table.last_saved'|trans()|desc('Last saved') }}{% endblock %}

{% block last_saved_cell %}{{ version.modificationDate|ibexa_full_datetime }}{% endblock %}

{% block actions_header %}{% endblock %}

{% block actions_cell %}
    {% set version_action_list = knp_menu_get(
        'ibexa.admin_ui.action.version_list',
        [],
        {
            versionInfo: version,
            isDraftConflict: is_draft_conflict,
            locationId: location.id ?? null
        })
    %}
    <div class="ibexa-table__cell-btns-wrapper">
        {{ knp_menu_render(version_action_list, {
            template: '@ibexadesign/ui/action_list.html.twig',
        }) }}
    </div>
{% endblock %}
