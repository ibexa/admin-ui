<section class="ibexa-view-rawcontentview">
    <div class="ibexa-raw-content-title">
        <h2 class="ibexa-raw-content-title__text">{{ 'tab.view.details'|trans|desc('Details') }}</h2>
        {% block extras %}{% endblock %}
    </div>

    {% block fields %}
        {% set has_multiple_groups = field_definitions_by_group|length > 1 %}

        <div class="ibexa-content-fields">
            {% for group in field_definitions_by_group %}
                {% set items = [] %}
                {% for field_definition in group.fieldDefinitions %}
                    {% set field_value %}
                        <div class="ibexa-content-field__value">
                            {% if ibexa_field_is_empty(content, field_definition.identifier) %}
                                <em>{{ 'fieldview.field.empty'|trans({}, 'ibexa_fieldview')|desc('This field is empty') }}</em>
                            {% else %}
                                {{ ibexa_render_field(content, field_definition.identifier, {location: location}) }}
                            {% endif %}
                        </div>
                    {% endset %}
                    {% set items = items|merge([{
                        class: 'ibexa-content-field',
                        label: field_definition.name,
                        content_raw: field_value,
                    }]) %}
                {% endfor %}

                <section class="ibexa-content-fields__group">
                    {% if has_multiple_groups %}
                        <h3 class="ibexa-content-fields__group-name">{{ group.name|capitalize }}</h3>
                    {% endif %}
                    {% include '@ibexadesign/ui/component/details/details.html.twig' with {
                        items,
                        view_mode: 'vertical',
                    } only %}
                </section>
            {% endfor %}
        </div>
    {% endblock %}
</section>
