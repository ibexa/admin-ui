<div class="ibexa-content-field" data-field-definition-identifier="{{ field_definition.identifier }}">
    <div class="ibexa-content-field__name">
        {{- field_definition.name -}}
        {{- ibexa_twig_component_group('admin-ui-content-view-field-actions', {
            content: content,
            location: location,
            field: field,
            field_definition: field_definition,
            language_code: language_code,
        }) -}}
    </div>
    <div class="ibexa-content-field__value">
        {% if ibexa_field_is_empty(content, field_definition.identifier) %}
            <em>{{ 'fieldview.field.empty'|trans({}, 'ibexa_fieldview')|desc('This field is empty') }}</em>
        {% else %}
            {{ ibexa_render_field(content, field_definition.identifier, {location: location}) }}
        {% endif %}
    </div>
</div>
