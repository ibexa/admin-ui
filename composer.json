{
    "name": "ibexa/admin-ui",
    "license": "(GPL-2.0-only or proprietary)",
    "type": "project",
    "description": "Ibexa Admin Ui",
    "replace": {
        "ezsystems/ezplatform-admin-ui": "*"
    },
    "autoload": {
        "psr-4": {
            "Ibexa\\AdminUi\\": "src/lib/",
            "Ibexa\\Bundle\\AdminUi\\": "src/bundle/",
            "Ibexa\\Contracts\\AdminUi\\": "src/contracts/",
            "Ibexa\\InternalContracts\\AdminUi\\": "src/internal-contracts/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ibexa\\Tests\\Bundle\\AdminUi\\": "tests/bundle/",
            "Ibexa\\Tests\\Integration\\AdminUi\\": "tests/integration/",
            "Ibexa\\Tests\\AdminUi\\": "tests/lib/"
        }
    },
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "babdev/pagerfanta-bundle": "^4.5",
        "ibexa/content-forms": "~6.0.x-dev",
        "ibexa/core": "~6.0.x-dev",
        "ibexa/design-engine": "~6.0.x-dev",
        "ibexa/design-system-twig": "~6.0.x-dev",
        "ibexa/jms-translation-bundle": "^3.0",
        "ibexa/rest": "~6.0.x-dev",
        "ibexa/search": "~6.0.x-dev",
        "ibexa/twig-components": "~6.0.x-dev",
        "ibexa/user": "~6.0.x-dev",
        "knplabs/knp-menu-bundle": "^3.0",
        "symfony/asset": "^8.1",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/deprecation-contracts": "^2.5 || ^3.0",
        "symfony/event-dispatcher": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/form": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/options-resolver": "^8.1",
        "symfony/process": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/security-core": "^8.1",
        "symfony/security-http": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/webpack-encore-bundle": "^2.2",
        "symfony/yaml": "^8.1",
        "twig/intl-extra": "^3.0",
        "twig/string-extra": "^3.0",
        "twig/twig": "^3.0",
        "willdurand/js-translation-bundle": "^8.0"
    },
    "require-dev": {
        "behat/behat": "^4.0@alpha",
        "dama/doctrine-test-bundle": "^8.2",
        "deptrac/deptrac": "^4.7",
        "ext-zip": "*",
        "friends-of-behat/mink-extension": "^3.0@alpha",
        "ibexa/admin-ui-assets": "dev-6.0-next",
        "ibexa/behat": "~6.0.x-dev",
        "ibexa/code-style": "~2.0.0",
        "ibexa/doctrine-migrations": "~6.0.x-dev",
        "ibexa/doctrine-schema": "~6.0.x-dev",
        "ibexa/http-cache": "~6.0.x-dev",
        "ibexa/notifications": "~6.0.x-dev",
        "ibexa/phpstan": "~6.0.x-dev",
        "ibexa/rector": "~6.0.x-dev",
        "ibexa/test-core": "~6.0.x-dev",
        "ibexa/test-rest": "~6.0.x-dev",
        "ibexa/translations": "~6.0.x-dev",
        "matthiasnoback/symfony-dependency-injection-test": "^6.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "webmozart/assert": "^2.3"
    },
    "config": {
        "allow-plugins": {
            "*": false
        },
        "sort-packages": true
    },
    "scripts": {
        "fix-cs": "php-cs-fixer fix --config=.php-cs-fixer.php -v --show-progress=dots",
        "check-cs": "@fix-cs --dry-run",
        "deptrac": "php vendor/bin/deptrac analyse",
        "phpstan": "phpstan analyse",
        "test-unit": "phpunit -c phpunit.xml",
        "test-integration": "phpunit -c phpunit.integration.xml",
        "test": [
            "@test-unit",
            "@test-integration"
        ]
    },
    "scripts-descriptions": {
        "deptrac": "Run Deptrac architecture testing"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.0.x-dev"
        }
    }
}
